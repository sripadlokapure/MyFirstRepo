# Copy to .env and fill in. Everything is optional except where noted.

# Lets Claude plan and carry out tasks. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=high          # low | medium | high | xhigh | max (lower = cheaper)

# Spending caps (USD, estimated from list prices). The assistant stops when a cap is hit. 0 = no cap.
# Also set a hard monthly limit in the Anthropic Console (Settings -> Limits).
MONTHLY_BUDGET_USD=10
TASK_BUDGET_USD=2

# Password your phone uses to talk to the server. At least 20 characters.
# Leave empty to get a strong random one in data/app-token.txt (recommended).
APP_TOKEN=

PORT=3000
# 127.0.0.1 = only reachable through a tunnel/proxy on this machine (recommended).
# HOST=127.0.0.1
# Behind a reverse proxy/tunnel on the same machine, so lockouts see real client IPs:
# TRUST_PROXY=loopback
# The HTTPS address your phone opens, used for links inside notifications.
PUBLIC_URL=

# Phone alerts through the free ntfy app (https://ntfy.sh). Pick a long, hard-to-guess topic name.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Access token if your ntfy topic is protected (self-hosted or ntfy Pro reserved topic).
# NTFY_TOKEN=
# false = alerts only say "something needs you"; no task details go to push services or ntfy.
# ALERT_DETAILS=true

# Let the agent search the web and read pages (on by default).
# ENABLE_WEB_TOOLS=true
# Restrict browsing to these sites only (comma separated), OR block specific sites (not both):
# WEB_ALLOWED_DOMAINS=wikipedia.org,weather.com
# WEB_BLOCKED_DOMAINS=example-bad.com

# Automations the agent may trigger by name (Zapier / Make / IFTTT / Home Assistant / n8n webhooks).
# WEBHOOKS={"share_list":"https://hooks.zapier.com/hooks/catch/123/abc","lights_off":"https://ha.example.com/api/webhook/xyz"}
# Each automation call waits for you to tap Allow (payload shown). Only set false if you're sure.
# WEBHOOKS_REQUIRE_APPROVAL=true

# Web Push identity. Keys are auto-generated into data/vapid.json if unset.
# VAPID_SUBJECT=mailto:you@example.com
