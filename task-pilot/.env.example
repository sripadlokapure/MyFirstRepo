# Copy to .env and fill in. Everything is optional except where noted.

# Lets Claude plan and carry out tasks. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=high          # low | medium | high | xhigh | max (lower = cheaper)

# Password your phone uses to talk to the server. Auto-generated into data/app-token.txt if unset.
APP_TOKEN=

PORT=3000
# The HTTPS address your phone opens, used for links inside notifications.
PUBLIC_URL=

# Phone alerts through the free ntfy app (https://ntfy.sh). Pick a long, hard-to-guess topic name.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Let the agent search the web and read pages (on by default).
# ENABLE_WEB_TOOLS=true

# Automations the agent may trigger by name (Zapier / Make / IFTTT / Home Assistant / n8n webhooks).
# WEBHOOKS={"share_list":"https://hooks.zapier.com/hooks/catch/123/abc","lights_off":"https://ha.example.com/api/webhook/xyz"}

# Web Push identity. Keys are auto-generated into data/vapid.json if unset.
# VAPID_SUBJECT=mailto:you@example.com
